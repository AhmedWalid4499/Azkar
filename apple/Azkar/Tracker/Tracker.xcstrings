        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a make-up fast"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل يوم قضاء"
          }
        }
      }
    },
    "Log each prayer on the Today tab or from a day in the calendar below, tick off the sunnah prayers, read the morning and evening azkar and log your fasts. Your streaks, how the last week and month went, missed prayers to make up, trends and all-time totals will gather here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log each prayer on the Today tab or from a day in the calendar below, tick off the sunnah prayers, read the morning and evening azkar and log your fasts. Your streaks, how the last week and month went, missed prayers to make up, trends and all-time totals will gather here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجِّل كل صلاة من تبويب «اليوم» أو من أي يوم في التقويم أدناه، وعلِّم ما صلَّيته من السنن، واقرأ أذكار الصباح والمساء، وسجِّل صيامك. وستجتمع هنا سلاسلك، وحصيلة الأسبوع والشهر الأخيرين، والصلوات الفائتة التي عليك قضاؤها، واتجاهات أسابيعك، ومجموعك منذ البداية."
          }
        }
      }
    },
