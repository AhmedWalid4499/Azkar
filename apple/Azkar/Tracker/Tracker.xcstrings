    "A day joins your streak when all five prayers are prayed, on time or made up later. Excused prayers never count against you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day joins your streak when all five prayers are prayed, on time or made up later. Excused prayers never count against you."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُضاف اليوم إلى سلسلتك إذا أُدِّيت صلواته الخمس كلها، في وقتها أو قضاءً. والصلوات التي لك فيها عذر لا تُحتسب عليك أبدًا."
          }
        }
      }
    },
    "A day of Tashriq: fasting is not permitted on this day.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
