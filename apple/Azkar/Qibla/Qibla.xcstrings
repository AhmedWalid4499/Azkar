    },
    "Hold your iPhone flat, away from metal and magnets.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أمسك هاتفك مستويًا، بعيدًا عن المعادن والمغناطيس."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your iPhone flat, away from metal and magnets."
          }
        }
      }
    },
    "Measured clockwise from true north.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاتجاه مقيس من الشمال الجغرافي مع اتجاه عقارب الساعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured clockwise from true north."
          }
        }
      }
    },
    "N": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ش"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "N"
          }
        }
      }
    },
    "North is at the top of the dial. Point the top of your iPhone north, using a map or a landmark you know, and the Kaaba on the dial shows the Qibla.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشمال في أعلى القرص. وجِّه أعلى هاتفك نحو الشمال مستعينًا بخريطة أو بمَعلم تعرفه، فتدلّك علامة الكعبة على القرص على القبلة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "North is at the top of the dial. Point the top of your iPhone north, using a map or a landmark you know, and the Kaaba on the dial shows the Qibla."
          }
        }
      }
    },
    "Qibla": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القبلة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Qibla"
          }
        }
      }
    },
