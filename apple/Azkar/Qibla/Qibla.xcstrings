    "Set your location": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد موقعك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your location"
          }
        }
      }
    },
    "The Qibla direction is worked out from where you are. Use your location, or search for your city.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحسب اتجاه القبلة من موقعك. استخدم موقعك الحالي، أو ابحث عن مدينتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Qibla direction is worked out from where you are. Use your location, or search for your city."
          }
        }
      }
    },
    "The compass is unsure of its direction. Move your iPhone in a figure-eight a few times, away from metal, to calibrate it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البوصلة غير متأكدة من الاتجاه. حرّك هاتفك في الهواء عدة مرات على شكل ∞، بعيدًا عن المعادن، لمعايرتها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compass is unsure of its direction. Move your iPhone in a figure-eight a few times, away from metal, to calibrate it."
          }
        }
      }
    },
