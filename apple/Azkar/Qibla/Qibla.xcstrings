{
  "sourceLanguage": "en",
  "strings": {
    "Compass dial, with the Qibla at %@ from north": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرص البوصلة، والقبلة فيه على %@ من الشمال"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compass dial, with the Qibla at %@ from north"
          }
        }
      }
    },
    "Distance to the Kaaba": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المسافة إلى الكعبة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance to the Kaaba"
          }
        }
      }
    },
