    "Waiting for the compass…": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار البوصلة…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the compass…"
          }
        }
      }
    },
    "Your iPhone’s compass is using magnetic north here, while the direction is measured from true north. In most places the two are a few degrees apart, so the dial can be off by that much; compare it with a mosque’s mihrab or a landmark you know.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعتمد بوصلة هاتفك هنا على الشمال المغناطيسي، أما الاتجاه فمقيس من الشمال الجغرافي. ويفصل بينهما في معظم الأماكن بضع درجات، فقد يحيد القرص بهذا القدر؛ فقارنه بمحراب مسجد أو بمَعلم تعرف اتجاهه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone’s compass is using magnetic north here, while the direction is measured from true north. In most places the two are a few degrees apart, so the dial can be off by that much; compare it with a mosque’s mihrab or a landmark you know."
          }
        }
      }
    },
    "Your saved location is less than a kilometre from the Kaaba. This close, the direction depends on exactly where you stand, so face the Kaaba itself. If you’re farther away, use your location to get a direction from where you are.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موقعك المحفوظ على بُعد أقل من كيلومتر من الكعبة. وعلى هذا القرب يتوقف الاتجاه على موضع وقوفك بالضبط، فتوجّه إلى الكعبة نفسها. وإن كنت أبعد من ذلك، فاستخدم موقعك الحالي لتحصل على الاتجاه من مكانك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved location is less than a kilometre from the Kaaba. This close, the direction depends on exactly where you stand, so face the Kaaba itself. If you’re farther away, use your location to get a direction from where you are."
          }
        }
      }
    },
    "You’re close to the Kaaba": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت قريب من الكعبة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re close to the Kaaba"
          }
        }
      }
    },
    "You’re facing the Qibla": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت متّجه إلى القبلة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re facing the Qibla"
          }
        }
      }
    }
  },
