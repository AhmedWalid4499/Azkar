    "Couldn’t reach Claude. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى Claude. تحقّق من اتصالك وحاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t reach Claude. Check your connection and try again."
