    "Not a scholar or a doctor. If you are in danger, call your local emergency number now.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس عالمًا ولا طبيبًا. إن كنت في خطر فاتصل برقم الطوارئ في بلدك الآن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a scholar or a doctor. If you are in danger, call your local emergency number now."
          }
        }
      }
    },
    "Past conversations": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
