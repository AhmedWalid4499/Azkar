    "Claude is busy right now. Try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude مشغول الآن. حاول بعد قليل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude is busy right now. Try again in a moment."
          }
        }
      }
    },
    "Claude returned an error (%lld): %@": {
      "extractionState": "manual",
