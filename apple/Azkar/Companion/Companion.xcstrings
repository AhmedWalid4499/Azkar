    "A key is saved. It stays in this iPhone’s Keychain and is never in your backups.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المفتاح محفوظ. يبقى في سلسلة مفاتيح هذا الآيفون ولا يدخل في نسخك الاحتياطية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A key is saved. It stays in this iPhone’s Keychain and is never in your backups."
          }
        }
      }
    },
    "API key": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
