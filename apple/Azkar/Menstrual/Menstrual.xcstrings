    },
    "During Hajj the Prophet ﷺ told Aisha, when her period came: “Do all that the pilgrim does, except going around the House until you are pure.” Sahih al-Bukhari 305." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ لعائشة رضي الله عنها لما حاضت في الحج: «فافعلي ما يفعل الحاج، غير أن لا تطوفي بالبيت حتى تطهري». صحيح البخاري ٣٠٥."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During Hajj the Prophet ﷺ told Aisha, when her period came: “Do all that the pilgrim does, except going around the House until you are pure.” Sahih al-Bukhari 305."
          }
        }
      }
    },
    "Each day is logged as an excused fast, so the days to make up are counted for you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُسجَّل كل يوم إفطارًا بعذر، فتُحصى لك الأيام التي تقضينها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each day is logged as an excused fast, so the days to make up are counted for you."
          }
        }
      }
    },
    "For women" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للنساء"
          }
        },
        "en" : {
