          }
        }
      }
    },
    "What you can still do" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يمكنك القيام به"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you can still do"
          }
        }
      }
    },
    "Where scholars differ, follow the scholars you trust." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وفيما اختلف فيه العلماء، اتّبعي من تثقين بعلمه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where scholars differ, follow the scholars you trust."
          }
        }
      }
    },
    "While it’s on, Azkar adjusts to these days. Until you turn it off:" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما دام مفعّلًا، يتكيّف أذكار مع هذه الأيام. وإلى أن توقفيه:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While it’s on, Azkar adjusts to these days. Until you turn it off:"
          }
        }
      }
    },
    "Yes, turn it on" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نعم، تفعيل الوضع"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes, turn it on"
          }
        }
      }
    },
    "Your morning and evening azkar, tasbih, and remembering Allah at any time." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أذكار الصباح والمساء والتسبيح، وذكر الله في كل وقت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your morning and evening azkar, tasbih, and remembering Allah at any time."
          }
        }
      }
    },
    "Your streaks and stats stay as they are, and an excused prayer is never owed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى سلاسلك وإحصاءاتك كما هي، والصلاة المعذورة لا تُقضى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your streaks and stats stay as they are, and an excused prayer is never owed."
          }
        }
      }
