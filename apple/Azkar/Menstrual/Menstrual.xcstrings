    "Aisha said: “We were commanded to make up the fasts, and we were not commanded to make up the prayers.” Sahih Muslim 335." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قالت عائشة رضي الله عنها: «فنؤمر بقضاء الصوم ولا نؤمر بقضاء الصلاة». صحيح مسلم ٣٣٥."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aisha said: “We were commanded to make up the fasts, and we were not commanded to make up the prayers.” Sahih Muslim 335."
          }
        }
      }
    },
