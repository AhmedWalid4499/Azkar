            "value" : "For women"
          }
        }
      }
    },
    "For women: during your period, prayers are logged as excused and their reminders pause." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للنساء: في أيام الحيض تُسجَّل الصلوات بعذر وتتوقف تذكيراتها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For women: during your period, prayers are logged as excused and their reminders pause."
          }
        }
      }
    },
    "Giving, however little, and helping those around you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العطاء ولو كان قليلًا، وإعانة من حولك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giving, however little, and helping those around you."
          }
        }
