    "By Imam an-Nawawi. %lld hadith, numbered as on sunnah.com. The Arabic is shown as the source gives it, some with vowel marks and some without.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للإمام النووي. %lld حديث، مرقّمة كما في sunnah.com. يُعرض النص العربي كما ورد في المصدر، بعضه مشكول وبعضه بلا تشكيل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By Imam an-Nawawi. %lld hadith, numbered as on sunnah.com. The Arabic is shown as the source gives it, some with vowel marks and some without."
          }
        }
      }
    },
