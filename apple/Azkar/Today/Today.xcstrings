    "Some times can’t be calculated here today because the sun doesn’t rise, doesn’t set, or stays too close to the horizon. Settings can borrow the times of the nearest latitude.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حساب بعض المواقيت هنا اليوم لأن الشمس لا تشرق، أو لا تغرب، أو تبقى قريبة جدًّا من الأفق. ويمكن من الإعدادات اعتماد مواقيت أقرب خط عرض."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some times can’t be calculated here today because the sun doesn’t rise, doesn’t set, or stays too close to the horizon. Settings can borrow the times of the nearest latitude."
          }
        }
      }
