    "Location Services are turned off. Turn them on in Settings › Privacy & Security, or search for your city.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمات الموقع متوقفة. شغّلها من «الإعدادات» ثم «الخصوصية والأمن»، أو ابحث عن مدينتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location Services are turned off. Turn them on in Settings › Privacy & Security, or search for your city."
          }
        }
      }
    },
    "Location access is off for Azkar. Allow it in Settings, or search for your city instead.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الموقع متوقف لتطبيق أذكار. اسمح به من «الإعدادات»، أو ابحث عن مدينتك بدلًا من ذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is off for Azkar. Allow it in Settings, or search for your city instead."
          }
        }
      }
    },
    "Location access is restricted on this iPhone, for example by Screen Time. Search for your city instead.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الموقع مقيَّد على هذا الجهاز، بسبب «مدة استخدام الجهاز» مثلًا. ابحث عن مدينتك بدلًا من ذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is restricted on this iPhone, for example by Screen Time. Search for your city instead."
          }
        }
      }
    },
