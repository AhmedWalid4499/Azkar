    },
    "Azkar couldn’t open your records" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على أذكار فتح سجلاتك"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azkar couldn’t open your records"
          }
        }
      }
    },
    "Azkar reminds you when each prayer’s time comes and asks whether you prayed before it ends." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يذكّرك أذكار بدخول وقت كل صلاة، ويسألك هل صلّيت قبل خروج وقتها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azkar reminds you when each prayer’s time comes and asks whether you prayed before it ends."
          }
        }
      }
    },
    "Azkar reminds you when each prayer’s time comes, asks whether you prayed before it ends, and can sound the adhan as an alarm, even in silent mode." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يذكّرك أذكار بدخول وقت كل صلاة، ويسألك هل صلّيت قبل خروج وقتها، ويمكنه رفع الأذان منبّهًا حتى في الوضع الصامت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azkar reminds you when each prayer’s time comes, asks whether you prayed before it ends, and can sound the adhan as an alarm, even in silent mode."
          }
        }
      }
    },
