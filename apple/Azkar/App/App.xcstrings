    "Used to greet you and in your reminders. It stays on this iPhone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحيّيك به ونذكره في تذكيراتك، ويبقى على هذا الآيفون فقط."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to greet you and in your reminders. It stays on this iPhone."
          }
        }
      }
    },
