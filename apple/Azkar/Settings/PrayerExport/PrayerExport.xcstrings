    "Prayer times are in your Calendar until %@. After changing the method, adjustments or location, add them again to update them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مواقيت الصلاة في تقويمك حتى %@. إذا غيّرت طريقة الحساب أو التعديلات أو الموقع فأضفها مرة أخرى لتحديثها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times are in your Calendar until %@. After changing the method, adjustments or location, add them again to update them."
          }
        }
      }
    },
    "Previous month": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
