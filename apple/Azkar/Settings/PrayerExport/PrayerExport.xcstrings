{
  "sourceLanguage": "en",
  "strings": {
    "Add to Calendar": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة إلى التقويم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to Calendar"
          }
        }
      }
    },
    "Adds the five prayers as events in a calendar of their own named “%@”, with the method and adjustments above. Adding again replaces them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضاف الصلوات الخمس أحداثًا في تقويم خاص بها اسمه «%@»، بطريقة الحساب والتعديلات أعلاه. وإضافتها مرة أخرى تحلّ محلّ السابقة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds the five prayers as events in a calendar of their own named “%@”, with the method and adjustments above. Adding again replaces them."
          }
        }
      }
    },
    "Asr time: %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت العصر: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asr time: %@"
          }
        }
      }
    },
    "Calculated by Azkar. Times can differ from your mosque’s by a few minutes; follow your mosque.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسبها تطبيق أذكار. قد تختلف المواقيت عن مواقيت مسجدك ببضع دقائق، فاتّبع مسجدك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated by Azkar. Times can differ from your mosque’s by a few minutes; follow your mosque."
          }
        }
      }
    },
