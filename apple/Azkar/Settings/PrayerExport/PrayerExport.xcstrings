          }
        }
      }
    },
    "Remove from Calendar": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة من التقويم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from Calendar"
          }
        }
      }
    },
    "Remove prayer times from Calendar?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة مواقيت الصلاة من التقويم؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove prayer times from Calendar?"
          }
        }
      }
    },
    "Set a location to add prayer times to Calendar or make a timetable.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدِّد موقعًا لإضافة مواقيت الصلاة إلى التقويم أو لإنشاء جدول شهري."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a location to add prayer times to Calendar or make a timetable."
          }
        }
      }
    },
    "The “%@” calendar and all its prayer times will be deleted.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف تقويم «%@» وكل مواقيت الصلاة فيه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The “%@” calendar and all its prayer times will be deleted."
          }
        }
      }
    },
    "To add and remove prayer times, allow Azkar full access to Calendar in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإضافة مواقيت الصلاة وإزالتها، اسمح لأذكار بالوصول الكامل إلى التقويم من الإعدادات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add and remove prayer times, allow Azkar full access to Calendar in Settings."
          }
        }
      }
    }
