    },
    "The middle of the night, halfway from Maghrib to Fajr, ends Isha’s preferred time according to a hadith in Sahih Muslim.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منتصف الليل، أي منتصف ما بين المغرب والفجر، هو آخر الوقت المختار لصلاة العشاء بحسب حديث في صحيح مسلم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The middle of the night, halfway from Maghrib to Fajr, ends Isha’s preferred time according to a hadith in Sahih Muslim."
          }
        }
      }
    },
    "The source details are given as their authors wrote them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفاصيل المصادر مذكورة كما كتبها أصحابها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source details are given as their authors wrote them."
          }
        }
      }
    },
    "The typeface of the mushaf, by Khaled Hosny.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خط المصحف، من تصميم خالد حسني."
