    "Alarms are turned off for Azkar, so the adhan can’t sound. Allow them in Settings › Apps › Azkar.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنبّهات متوقفة لتطبيق أذكار، فلا يمكن أن يُرفع الأذان. اسمح بها من الإعدادات ‹ التطبيقات ‹ أذكار."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms are turned off for Azkar, so the adhan can’t sound. Allow them in Settings › Apps › Azkar."
          }
        }
      }
    },
