    "Calculation methods differ from region to region, and each mosque follows one of them. Choose the settings your local mosque uses so these times match its timetable.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختلف طرق الحساب من منطقة إلى أخرى، ولكل مسجد طريقة يعتمدها. اختر الإعدادات المعمول بها في مسجد حيّك لتوافق هذه المواقيتُ جدولَه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculation methods differ from region to region, and each mosque follows one of them. Choose the settings your local mosque uses so these times match its timetable."
          }
        }
      }
    },
    "Caps Fajr and Isha at high latitudes around midsummer, when twilight lasts most or all of the night.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تضبط وقتَي الفجر والعشاء في خطوط العرض العليا حول منتصف الصيف، حين يستمر الشفق معظم الليل أو كلَّه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Fajr and Isha at high latitudes around midsummer, when twilight lasts most or all of the night."
          }
        }
      }
    },
