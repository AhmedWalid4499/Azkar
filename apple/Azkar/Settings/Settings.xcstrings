    "Azkar asks for permission the first time a reminder needs it. Reminders are set on this iPhone for the days ahead, so they arrive even when the app is closed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب التطبيق الإذن عند أول تنبيه يحتاج إليه. وتُضبط التنبيهات على هذا الهاتف للأيام المقبلة، فتصلك حتى إن كان التطبيق مغلقًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Azkar asks for permission the first time a reminder needs it. Reminders are set on this iPhone for the days ahead, so they arrive even when the app is closed."
          }
        }
      }
    },
