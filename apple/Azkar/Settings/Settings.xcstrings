    "The backup couldn’t be saved, so nothing was changed. This iPhone’s storage may be full.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ النسخة الاحتياطية، فلم يتغيّر شيء. قد تكون مساحة التخزين على هذا الهاتف ممتلئة."
          }
