        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The typeface of the mushaf, by Khaled Hosny."
          }
        }
      }
    },
    "This permanently removes your prayer log, azkar progress, tasbih counts, fasts, location and settings from this iPhone. Export a backup first if you might want them again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف من هذا الهاتف نهائيًا سجل صلواتك وتقدّمك في الأذكار وعدد تسبيحاتك وصيامك وموقعك وإعداداتك. صدِّر نسخة احتياطية أولًا إن كنت قد تحتاج إليها لاحقًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes your prayer log, azkar progress, tasbih counts, fasts, location and settings from this iPhone. Export a backup first if you might want them again."
          }
        }
      }
    },
    "This place keeps a different time from your iPhone. If you’ve travelled, update your location.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقيت هذا المكان يختلف عن توقيت هاتفك. إن كنت قد سافرت فحدِّث موقعك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This place keeps a different time from your iPhone. If you’ve travelled, update your location."
          }
        }
      }
    },
