    "Pray Maghrib and Isha together, spend the night, and after Fajr remember Allah at al-Mash'ar al-Haram.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pray Maghrib and Isha together, spend the night, and after Fajr remember Allah at al-Mash'ar al-Haram."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صلِّ المغرب والعشاء جمعًا وبِتْ بها، واذكر الله بعد الفجر عند المشعر الحرام."
          }
        }
      }
    },
    "Pray two rakahs behind the Station of Ibrahim, or anywhere in the mosque, then drink Zamzam.": {
      "extractionState": "manual",
