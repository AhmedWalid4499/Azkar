      }
    },
    "Shows the steps of Umrah and Hajj on Today, with their duas and a counter for the laps of tawaf and sa'i.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the steps of Umrah and Hajj on Today, with their duas and a counter for the laps of tawaf and sa'i."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض مناسك العمرة والحج في صفحة اليوم، مع أدعيتها وعدّاد لأشواط الطواف والسعي."
          }
        }
      }
    },
    "Stand at Arafah from after noon until sunset in dua and remembrance, then go to Muzdalifah.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand at Arafah from after noon until sunset in dua and remembrance, then go to Muzdalifah."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قف بعرفة من بعد الزوال إلى غروب الشمس في دعاء وذكر، ثم انصرف إلى مزدلفة."
          }
        }
      }
    },
    "Start again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start again"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ من جديد"
          }
        }
      }
    },
    "Stay at Mina and each day after noon stone the three jamarat, seven pebbles each, making dua after the first two.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay at Mina and each day after noon stone the three jamarat, seven pebbles each, making dua after the first two."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بِتْ بمنى، وارمِ كل يوم بعد الزوال الجمرات الثلاث بسبع حصيات لكلٍّ منها، وادعُ بعد الأولى والوسطى."
          }
        }
      }
    },
    "Stone Jamrat al-Aqabah with seven pebbles, offer the sacrifice, shave or shorten the hair, and make tawaf al-ifadah and the sa'i.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stone Jamrat al-Aqabah with seven pebbles, offer the sacrifice, shave or shorten the hair, and make tawaf al-ifadah and the sa'i."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارمِ جمرة العقبة بسبع حصيات، واذبح هديك، واحلق أو قصّر، وطُف طواف الإفاضة واسعَ."
          }
        }
      }
    },
