        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Men shave the head or shorten the hair; women shorten it by a fingertip's length. The Umrah is complete."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحلق الرجل رأسه أو يقصّر، وتقصّر المرأة قدر أنملة، وبذلك تتمّ العمرة."
          }
        }
      }
    },
