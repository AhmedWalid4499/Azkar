    "Seven laps between as-Safa and al-Marwah, starting at as-Safa and ending at al-Marwah.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seven laps between as-Safa and al-Marwah, starting at as-Safa and ending at al-Marwah."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبعة أشواط بين الصفا والمروة، تبدأ بالصفا وتنتهي بالمروة."
          }
        }
      }
    },
    "Seven laps round the Ka'bah, starting at the Black Stone. Say the takbir each time you pass it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seven laps round the Ka'bah, starting at the Black Stone. Say the takbir each time you pass it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبعة أشواط حول الكعبة تبدأ من الحجر الأسود، وكبّر كلما حاذيته."
          }
        }
      }
    },
    "Shaving or shortening the hair": {
      "extractionState": "manual",
      "localizations": {
