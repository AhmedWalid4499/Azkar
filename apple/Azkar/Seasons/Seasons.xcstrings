    "Dates follow the Umm al-Qura calendar with your Hijri date adjustment. Local moon sighting can differ by a day or two.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التواريخ حسب تقويم أم القرى مع ضبط التاريخ الهجري الذي اخترته، وقد تختلف رؤية الهلال المحلية بيوم أو يومين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates follow the Umm al-Qura calendar with your Hijri date adjustment. Local moon sighting can differ by a day or two."
          }
        }
      }
    },
